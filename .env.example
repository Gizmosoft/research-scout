OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
PAPER_TARGET=15
BLOG_TARGET=5
BLOG_MIN_SCORE=70
DATA_DIR=data
RESULTS_DIR=results
LOGS_DIR=logs
METRICS_DIR=metrics
WEB_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
